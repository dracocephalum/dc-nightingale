    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The samples host the server in-process, so they need the web framework the service library builds on. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- TEMPORARY: cross-component project reference. Components reference each
       other as packages (agentics/rules/layout.md); this stands in until a
       package feed exists. Listed in TODO.md. -->
  <ItemGroup>
    <ProjectReference Include="../../../../libraries/client/src/Dracocephalum.Nightingale.Client/Dracocephalum.Nightingale.Client.csproj" />
    <ProjectReference Include="../../../../libraries/server/src/Dracocephalum.Nightingale.Server.Polecat/Dracocephalum.Nightingale.Server.Polecat.csproj" />
  </ItemGroup>

</Project>
