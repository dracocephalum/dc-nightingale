<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for Microsoft.Testing.Extensions.CodeCoverage, the
  platform's own collector. Passed on the command line - the unit-test rules
  under agentics/rules/coding/csharp/ have the command.

  Short on purpose. Every exclusion is an unmeasured file, and a long list
  drifts, so only code nobody writes by hand is left out: test assemblies,
  anything compiled from obj/ (generated code - protobuf and the like carries no
  attribute the collector would see), and the three attributes that mark
  generated or deliberately excluded members. A class that is hard to test is
  a finding about the class, not a row here. Measured: with defaults the report
  counted the test assembly and generated code; with this file, only the
  hand-written sources.

  This is the Microsoft schema - regular expressions over module paths, source
  paths and attribute names - not coverlet's, which does not run under the
  platform.
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <ModulePath>.*\.Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <UseVerifiableInstrumentation>False</UseVerifiableInstrumentation>
  </CodeCoverage>
</Configuration>
