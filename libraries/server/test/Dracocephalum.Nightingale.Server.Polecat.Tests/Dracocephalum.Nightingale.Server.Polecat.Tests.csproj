<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reader's queries run on the in-memory provider; SQL Server's part is the integration suite's. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- FakeLogger, for what the store's schema tooling is told to log. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dracocephalum.Nightingale.Server.Polecat/Dracocephalum.Nightingale.Server.Polecat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The approved copy of the event store's schema, read from the output folder by the test that compares it. -->
    <None Include="Approved/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
