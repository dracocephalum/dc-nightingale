<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <!-- Rich error statuses: google.rpc.Status with an ErrorInfo detail, as the contract promises. -->
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <!-- The gateway's own tables as one model every backend shares; a backend brings the provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <!-- TEMPORARY: cross-component project reference. Components reference each
       other as packages (agentics/rules/layout.md); this stands in until a
       package feed exists. Listed in TODO.md. -->
  <ItemGroup>
    <ProjectReference Include="../../../core/src/Dracocephalum.Nightingale.Core/Dracocephalum.Nightingale.Core.csproj" />
    <ProjectReference Include="../../../core/src/Dracocephalum.Nightingale.Protocols.Grpc/Dracocephalum.Nightingale.Protocols.Grpc.csproj" />
  </ItemGroup>

  <!-- The public surface is what a host calls. What a backend and its tests reach
       beyond that is internal, and granted here by name; the project's own tests
       are granted in Directory.Build.props. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Dracocephalum.Nightingale.Server.Polecat" />
    <InternalsVisibleTo Include="Dracocephalum.Nightingale.Server.Tests.Contracts" />
    <InternalsVisibleTo Include="Dracocephalum.Nightingale.Server.Polecat.Tests" />
    <InternalsVisibleTo Include="Dracocephalum.Nightingale.Server.Polecat.Tests.Integration" />
    <!-- The assembly FakeItEasy generates its fakes into, so a test can fake an internal port. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
