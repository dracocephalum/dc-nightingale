{
  "ConnectionStrings": {
    "Nightingale": "Server=localhost;Database=nightingale;Trusted_Connection=True;TrustServerCertificate=True;Command Timeout=300"
  },
  "Nightingale": {
    "ConnectionStringName": "Nightingale",
    "SchemaMode": "Verify",
    "IndexMigrationStatementTimeout": "01:00:00",
    "SchemaLockWaitTimeout": "00:00:30",
    "FastBoot": false,
    "TailPollingInterval": "00:00:01",
    "MaxEventsPerAppend": 150,
    "UseReadOnlyConnection": true,
    "ReadOnlyConnectionStringName": null,
    "ReadStreamsFromReadOnlyConnection": false,
    "Deletion": {
      "Allowed": "None"
    },
    "Cluster": {
      "AdvertisedAddress": null
    },
    "Store": {
      "Schema": "dbo",
      "Collation": "Latin1_General_100_BIN2_UTF8",
      "IgnoreCollationCompatibility": false,
      "Partitioning": "None",
      "AssignOrdinals": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
