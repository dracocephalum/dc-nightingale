<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this repository.

  <clear /> discards every source inherited from machine- and user-level
  NuGet configuration, so the repository's dependency graph resolves only from
  the sources listed here - on every machine, including CI.

  packageSourceMapping pins each package pattern to one source. This is the
  defence against dependency confusion: a package name that exists on a
  private feed cannot be silently satisfied by a same-named upload to
  nuget.org, or vice versa.

  Adding a private feed:
    1. add it under packageSources
    2. add a packageSource block for it with the patterns it owns, e.g.
         <package pattern="Contoso.*" />
    3. keep nuget.org's pattern at "*" - the most specific pattern wins, so
       Contoso.* goes to the private feed and everything else to nuget.org.
  Never give two sources the same pattern.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
